# ------------------------------------------------------------------------------
# Disney World Public School - Environment Configuration
# ------------------------------------------------------------------------------

# Database Connection (Neon Serverless PostgreSQL)
# Get this from your Neon Console (https://console.neon.tech):
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pool.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Server Port (Used when deploying to Hostinger, VPS, or Docker)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# ------------------------------------------------------------------------------
# Real Gmail OTP Dispatcher Configuration
# ------------------------------------------------------------------------------
GMAIL_USER=dwpsballabgarh@gmail.com

# OPTION 1: Google OAuth2 via googleapis (RECOMMENDED for Live Domains)
# Avoids Google IP security blocks and data-center SMTP blocks on cloud hosting.
# 1. Create a Project on Google Cloud Console (https://console.cloud.google.com)
# 2. Enable Gmail API (APIs & Services -> Enable APIs -> Gmail API)
# 3. Create OAuth 2.0 Client ID (Web Application or Desktop)
# 4. Authorize scope: https://www.googleapis.com/auth/gmail.send
# 5. Generate Refresh Token via OAuth 2.0 Playground (https://developers.google.com/oauthplayground)
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=1//your-google-oauth-refresh-token

# OPTION 2: Standard SMTP App Password Fallback
# 1. Enable 2-Step Verification on dwpsballabgarh@gmail.com
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password (Name: "DWPS School Website")
# 4. Paste the 16-character code below:
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

